# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=jpwhite3/polyglot:latest

# Stage 1: Build Whisper.cpp
FROM ubuntu:24.04 AS whisper-builder
USER root
RUN apt-get update && apt-get install -y --no-install-recommends cmake build-essential git ca-certificates
RUN git clone https://github.com/ggerganov/whisper.cpp.git /opt/whisper.cpp && \
    cd /opt/whisper.cpp && \
    cmake -B build -DGGML_CUDA=0 && \
    cmake --build build --config Release && \
    cp build/bin/whisper-cli /usr/local/bin/whisper-cli || cp build/bin/main /usr/local/bin/whisper-cli && \
    cp build/bin/whisper-server /usr/local/bin/whisper-server || true && \
    find build -name "*.so*" -exec cp {} /usr/local/lib/ \;

# Stage 2: Final image combining polyglot and Hermes Agent
FROM ${BASE_IMAGE} AS final

USER root

# Disable Python stdout buffering to ensure logs are printed immediately
ENV PYTHONUNBUFFERED=1

# Configure Rust environment variables for non-root toolchain access
ENV RUSTUP_HOME=/root/.rustup \
    CARGO_HOME=/root/.cargo

# Store Playwright browsers outside the volume mount so the build-time
# install survives the /opt/data volume overlay at runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright

# Install system dependencies needed by Hermes and Whisper.cpp
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        tini \
        libffi-dev \
        procps \
        openssh-client \
        ripgrep

# Copy gosu and uv/uvx
COPY --chmod=0755 --from=tianon/gosu:1.19 /gosu /usr/local/bin/
COPY --chmod=0755 --from=ghcr.io/astral-sh/uv:0.11.6 /uv /uvx /usr/local/bin/

# Copy Whisper.cpp binaries and libraries
COPY --from=whisper-builder /usr/local/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper-builder /usr/local/bin/whisper-server /usr/local/bin/whisper-server
COPY --from=whisper-builder /usr/local/lib/ /usr/local/lib/
RUN ldconfig

# Non-root user for runtime; UID can be overridden via HERMES_UID at runtime
RUN useradd -u 10000 -m -d /opt/data hermes

# Clone Hermes Agent repository
RUN git clone https://github.com/NousResearch/hermes-agent.git /opt/hermes
WORKDIR /opt/hermes

# Install dependencies (npm and playwright)
ENV npm_config_install_links=false
RUN npm install --prefer-offline --no-audit && \
    npx playwright install --with-deps chromium --only-shell && \
    (cd web && npm install --prefer-offline --no-audit) && \
    (cd ui-tui && npm install --prefer-offline --no-audit) && \
    npm cache clean --force

# Build browser dashboard and terminal UI assets.
RUN cd web && npm run build && \
    cd ../ui-tui && npm run build

# Python dependency install via uv
RUN touch ./README.md
RUN uv sync --frozen --no-install-project --extra all --extra messaging

# Link hermes-agent itself (editable)
RUN uv pip install --no-cache-dir --no-deps -e "."

# Fix permissions of the /root directory so that non-root user 'hermes' can run development tools
RUN chmod 755 /root && \
    chmod -R 755 /root/.nvm /root/.cargo /root/.local /root/.opencode /root/.oh-my-zsh 2>/dev/null || true

# Make install dir world-readable so any HERMES_UID can read it at runtime.
# The venv needs to be traversable too.
RUN chmod -R a+rX /opt/hermes && \
    chown -R hermes:hermes /opt/hermes/.venv /opt/hermes/ui-tui /opt/hermes/node_modules

# ---------- Runtime ----------
ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
ENV HERMES_HOME=/opt/data
ENV PATH="/opt/data/.local/bin:${PATH}"
RUN mkdir -p /opt/data && chown -R hermes:hermes /opt/data
VOLUME [ "/opt/data" ]
ENTRYPOINT [ "/usr/bin/tini", "-g", "--", "/opt/hermes/docker/entrypoint.sh" ]
